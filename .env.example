# ── Pulse Finance ───────────────────────────────────────────────
# Demo mode requires NO third-party credentials. Copy to .env.local and run.

# demo | plaid
DATA_PROVIDER=demo

# Database (Postgres recommended; SQLite acceptable for local dev — see CLAUDE.md)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse

# Auth.js v5
AUTH_SECRET=generate-with--npx-auth-secret
AUTH_URL=http://localhost:3000
# Optional social login
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Encryption key for Plaid access tokens at rest (32 bytes, base64)
DATA_ENCRYPTION_KEY=

# Plaid (only when DATA_PROVIDER=plaid)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# Cron protection for /api/cron/sync
CRON_SECRET=
