# ── Pulse Finance ───────────────────────────────────────────────
# Demo mode requires NO third-party credentials. Copy to .env.local and run.

# demo | plaid
DATA_PROVIDER=demo

# Database. Local dev/test uses SQLite (file:./dev.db) with ZERO credentials.
# The adapter is chosen by URL scheme (src/lib/db-adapter.ts): a postgres:// URL
# switches the app to Postgres in production. Money = Int cents, business dates =
# YYYY-MM-DD strings; the schema is fully PG-portable (DECISIONS #35).
DATABASE_URL="file:./dev.db"
# Production (e.g. Vercel + Neon): use the Neon DIRECT (non-pooled) endpoint —
# NOT the -pooler host (PgBouncer breaks node-postgres prepared statements):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/pulse?sslmode=require
# The Vercel build (vercel.json) derives a postgresql schema, db-pushes it, then
# builds. Seed the demo data once: DATABASE_URL=<pulse> npx prisma db seed

# Auth.js v5 — generate with `npx auth secret`. AUTH_URL is optional
# (trustHost derives it; leave unset so dev/e2e ports both work).
AUTH_SECRET=generate-with--npx-auth-secret
# Optional social login (Phase 4 dormant)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Invite-only signup (DECISIONS #57). UNSET/blank → signup is OPEN (demo + local
# + tests need this). Set it to make account creation invite-only: a comma/space/
# newline/semicolon-separated list of allowed emails and/or whole domains. Gates
# NEW signups only — existing accounts always sign in. e.g.:
#   SIGNUP_ALLOWLIST="wife@example.com, tester1@gmail.com, @ourteam.com"
SIGNUP_ALLOWLIST=

# Demo mode pins "today" so the seeded dataset stays coherent (= seed asOf).
DEMO_TODAY=2026-06-10

# Optional: AI-assisted categorization for UNKNOWN merchants (DECISIONS #38, #64).
# With no key the deterministic categorizer is used (demo needs no key); the LLM
# only ever *suggests* and still flows through confidence routing + your review.
# Provider preference: XAI_API_KEY (cheaper) is used first, else ANTHROPIC_API_KEY.
#
# xAI / Grok — OpenAI-compatible, cheapest option (get a key at console.x.ai):
XAI_API_KEY=
# XAI_MODEL=grok-3-mini       # default; or grok-4.1-fast for the cheapest tier
#
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Encryption key for Plaid access tokens at rest (32 bytes, base64):
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Plaid (only when DATA_PROVIDER=plaid — see docs/PLAID_WALKTHROUGH.md)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
# OAuth redirect URI — required ONLY to link big OAuth banks (Chase, BofA, …).
# Must EXACTLY match a URI registered under Allowed redirect URIs in the Plaid
# dashboard, e.g. https://www.aimplifi.app/plaid-oauth (and http://localhost:3000/plaid-oauth
# for local). Leave blank to keep non-OAuth linking working with no extra setup.
PLAID_REDIRECT_URI=

# Bearer secret protecting /api/cron/sync and /api/cron/reminders
CRON_SECRET=

# Optional: payment-reminder emails (ROADMAP #6). With NO key the reminder cron
# (/api/cron/reminders) runs DORMANT — it computes what it would send and audits
# it, but sends nothing (zero-credential demo). Set a Resend API key to switch on.
RESEND_API_KEY=
# REMINDER_FROM_EMAIL="Pulse Finance <reminders@yourdomain.com>"
