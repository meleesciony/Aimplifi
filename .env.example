# ── Pulse Finance ───────────────────────────────────────────────
# Demo mode requires NO third-party credentials. Copy to .env.local and run.

# demo | plaid
DATA_PROVIDER=demo

# Database. Local dev/test uses SQLite (file:./dev.db); the schema is portable
# to Postgres (money = Int cents, business dates = YYYY-MM-DD strings).
DATABASE_URL="file:./dev.db"
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse

# Auth.js v5 — generate with `npx auth secret`. AUTH_URL is optional
# (trustHost derives it; leave unset so dev/e2e ports both work).
AUTH_SECRET=generate-with--npx-auth-secret
# Optional social login (Phase 4 dormant)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Demo mode pins "today" so the seeded dataset stays coherent (= seed asOf).
DEMO_TODAY=2026-06-10

# Encryption key for Plaid access tokens at rest (32 bytes, base64):
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Plaid (only when DATA_PROVIDER=plaid — see docs/PLAID_WALKTHROUGH.md)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=

# Bearer secret protecting /api/cron/sync
CRON_SECRET=
