// Pulse Finance — Prisma schema (Phase 1)
//
// Conventions (binding — see docs/PHASE_0_ARCHITECTURE.md and docs/DECISIONS.md):
//  - All money fields are Int CENTS. Transactions: outflow negative, inflow positive.
//    Account balances stored POSITIVE; `type` decides asset vs liability.
//  - All business dates are String YYYY-MM-DD (10 chars), validated/manipulated only
//    via src/lib/dates.ts. Timestamps (DateTime) exist only for audit/createdAt.
//  - SQLite is the local/dev database (no enums, no Json type) — enum-like fields are
//    String with the allowed values documented here and enforced by TS unions at the
//    data layer. Schema stays portable to Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String  @id @default(cuid())
  email             String  @unique
  name              String?
  passwordHash      String? // scrypt hash for email/password sign-in (null = demo/OAuth-only)
  hourlyWageCents   Int? // YMOYL life-energy view (after-tax effective)
  swrBps            Int     @default(400) // safe withdrawal rate, basis points
  expectedReturnBps Int     @default(700) // opportunity-cost compounding
  moneyDials        String? // JSON-encoded string[] (SQLite has no Json type)
  paymentAccountId  String? // designated checking account for card payments
  // Multi-device session invalidation (Gap 6 §3). Stamped into the JWT at sign-in
  // and re-checked on every Node-side session resolution; bumping it (see
  // revokeOtherSessions) makes every previously issued token stale. A deleted user
  // (row gone) also fails the check, so an account deletion kills sessions on every
  // device. Default 0 keeps existing/demo tokens valid — golden-safe.
  sessionEpoch      Int     @default(0)
  // Retirement-planning assumptions (DECISIONS #123). Nullable: null = use the
  // documented RETIREMENT_ASSUMPTIONS default, so an un-customized (e.g. demo)
  // user projects identically to #122 and golden values never move.
  currentAge        Int? // age today; null → default 40
  retirementAge     Int? // planned retirement age; null → default 65
  endAge            Int? // plan-through age; null → default 95
  inflationBps      Int? // long-run inflation assumption, bps; null → default 250 (2.50%)
  // Calendar date (YYYY-MM-DD, provider "today") of the user's last dashboard view,
  // for the return-moment greeting (TASKS 1.1). A CALENDAR DATE, not a timestamp, per
  // the date-discipline rule — so the gap is measured in the same civil-date domain as
  // everything else and is TZ-free. null = never viewed (first-ever visit shows no
  // greeting). Golden-safe: no engine reads it, and the demo user's fixed provider
  // "today" means every stamp equals the last, so the demo gap is always 0 (no card).
  lastSeenDate      String?

  accounts            Account[]
  rules               CategorizationRule[]
  goals               Goal[]
  budgets             Budget[]
  auditLogs           AuditLog[]
  corrections         Correction[]
  recurring           RecurringSeries[]
  plaidItems          PlaidItem[]
  simplefin           SimpleFinConnection?
  predictions         CategoryPrediction[]
  hiddenCategories    HiddenCategory[]
  customCategories    Category[]
  pushSubscriptions   PushSubscription[]
  notificationsSent   NotificationSent[]
  valueReceipts       ValueReceipt[]
  unknownQuestions    UnknownQuestion[]
  vocabEntries        VocabEntry[]
  engagementEvents    EngagementEvent[]
  nudgeDismissals     NudgeDismissal[]
  incomePauseConfirmations IncomePauseConfirmation[]
  selfAuditSnapshots  SelfAuditSnapshot[]
  householdMembership HouseholdMember? // v1: at most one household per user (HOUSEHOLD_ARCHITECTURE §4.1)
}

// PII-free deletion record (Gap 6 §3, docs/PRIVACY.md §Deletion). Deliberately has
// NO relation to User, so `prisma.user.delete`'s cascade never removes it: it is the
// one artifact that outlives the account. It retains only a one-way salted hash of the
// deleted user's id (hashUserRef) plus a timestamp — no email, no name, nothing
// recoverable — proving a deletion occurred without keeping personal data. Hashed with
// a SECRET salt (AUTH_SECRET) in production, so the records are non-enumerable even
// though a user id can be low-entropy (a Google id embeds an email).
model DeletionRecord {
  id          String   @id @default(cuid())
  userRefHash String // sha256(salt:userId), PII-free
  deletedAt   DateTime @default(now())

  @@index([userRefHash])
}

// Per-user "hide this category from the pickers" preference (DECISIONS #110).
// A row's PRESENCE means hidden. We never delete the global Category row (system
// categories are shared + FK'd by historical transactions/rules/budgets), so
// "delete the ones I don't use" is modeled as a per-user hide: the category
// vanishes from every assignment picker but anything already filed under it
// still renders its real name in reports/trends. `categoryId` is the category
// slug (not a Category FK — system rows are never deleted, so no cascade needed).
model HiddenCategory {
  id         String @id @default(cuid())
  userId     String
  categoryId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
}

// A user's SimpleFIN connection (ROADMAP: cheaper Plaid alternative). The access
// URL embeds basic-auth credentials, so it is AES-256-GCM encrypted at rest
// (src/lib/crypto.ts) — never plaintext, never logged. One connection per user.
model SimpleFinConnection {
  id                String   @id @default(cuid())
  userId            String   @unique
  accessUrl         String // AES-256-GCM ciphertext (the URL carries the credentials)
  lastSyncedAt      String? // YYYY-MM-DD — last SUCCESSFUL sync
  lastSyncAttemptAt String? // YYYY-MM-DD — last attempt (success or failure)
  lastSyncError     String? // sanitized SyncFailureReason on a failed attempt; null when healthy (Gap 1 §4)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One linked Plaid Item (institution connection) per row. Holds the access
// token (AES-256-GCM encrypted at rest — never plaintext, never logged) and
// the per-item /transactions/sync cursor. Replaces the v1 stopgap of packing
// the token into Account.providerRef (ROADMAP #1).
model PlaidItem {
  id                String   @id @default(cuid())
  userId            String
  itemId            String   @unique
  accessToken       String // AES-256-GCM ciphertext (see src/lib/crypto.ts)
  cursor            String? // /transactions/sync incremental cursor
  institution       String?
  lastSyncedAt      String? // YYYY-MM-DD — last SUCCESSFUL per-item sync (Gap 1 §4)
  lastSyncAttemptAt String? // YYYY-MM-DD — last attempt (success or failure)
  lastSyncError     String? // sanitized SyncFailureReason on a failed attempt; null when healthy
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String  @id @default(cuid())
  userId                String
  provider              String // 'demo' | 'plaid'
  providerRef           String?
  name                  String
  type                  String // CHECKING | SAVINGS | CREDIT | INVESTMENT | LOAN
  mask                  String? // last 4 only — never full numbers
  currentBalanceCents   Int // stored positive; type determines net-worth sign
  currency              String? // ISO-4217 (e.g. 'USD'); null = legacy/assumed USD. Non-USD accounts are withheld from net worth — no FX (DECISIONS #135, #127 audit #3/#10).
  availableBalanceCents Int?
  creditLimitCents      Int?
  aprBps                Int? // credit cards / loans
  minimumPaymentCents   Int? // non-card LOAN/MORTGAGE: fixed monthly payment (cards use Statement.minimumPaymentCents)
  dueDayOfMonth         Int? // credit cards: issuer due day (e.g. 15, 28)
  cycleCloseDayOfMonth  Int? // credit cards: statement close day
  plaidItemId           String? // #256: the Plaid item (bank connection) this account belongs to. Stamped on every Plaid account upsert AND best-effort at item disconnect; null on non-Plaid rows and on rows not yet re-synced since this column shipped. Read by the synced-account delete guard: a null linkage falls back to the conservative zero-items rule (see server/account-delete.ts).
  sharedToHousehold     Boolean @default(false) // owner-consented read-only share into the owner's CURRENT household (HOUSEHOLD_ARCHITECTURE §4.1). Deliberately names no household: visibility requires BOTH this flag AND live membership, so departure ends visibility instantly. Read via `partnerSharedAccountsWhere`/`visibleAccountsWhere` (src/server/authz.ts) ONLY (4.2 slice 2).

  autopay      AutopayConfig?
  statements   Statement[]
  transactions Transaction[]
  scheduled    ScheduledTransaction[]
  snapshots    BalanceSnapshot[]
  holdings     Holding[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Investment holdings — a position breakdown of an INVESTMENT account (DECISIONS #78).
// Powers the portfolio view (market value, cost basis, unrealized gain, allocation) via
// the pure investments engine. The account's currentBalanceCents stays authoritative for
// net worth; holdings are an optional, additive detail (they may not sum to the balance).
// `quantity` is shares (may be fractional); priceCents/costBasisCents are integer cents.
model Holding {
  id               String   @id @default(cuid())
  accountId        String
  symbol           String
  name             String?
  quantity         Float // shares; may be fractional
  costBasisCents   Int // total invested, integer cents
  priceCents       Int // current price per share, integer cents
  // Authoritative TOTAL market value, integer cents (DECISIONS #129, live-ingest
  // backlog #5). A brokerage feed reports a position's TOTAL market_value; deriving
  // it from a rounded per-share priceCents loses low-price / high-quantity lots (a
  // penny-stock lot can reconstruct to $0, or a sub-dollar lot to 2× its real value).
  // When set (source='simplefin'), the engine uses this total directly. NULL for
  // manual holdings → the engine derives round(quantity × priceCents), so the seed
  // and every demo/golden value stay byte-identical.
  marketValueCents Int?
  // Provenance (DECISIONS #124). 'manual' = user-entered; 'simplefin' = ingested
  // from a connected brokerage feed. Default 'manual' so existing/demo-seeded rows
  // keep their meaning and golden values never move. INVARIANT: a SimpleFIN sync
  // touches ONLY its own source='simplefin' rows — it never modifies (even on a
  // same-ticker collision) or deletes a source='manual' position, so a hand-entered
  // holding (and its cost basis) is never overwritten or wiped by the feed.
  source           String   @default("manual")
  updatedAt        DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol]) // one row per symbol per account → upsert target
  @@index([accountId])
}

model AutopayConfig {
  id               String @id @default(cuid())
  accountId        String @unique
  mode             String // STATEMENT_BALANCE | MINIMUM | FIXED_AMOUNT
  fixedAmountCents Int?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Statement {
  id                    String  @id @default(cuid())
  accountId             String
  cycleStart            String // YYYY-MM-DD
  cycleEnd              String // YYYY-MM-DD (statement close)
  dueDate               String // YYYY-MM-DD raw issuer due date (pre weekend-adjust)
  statementBalanceCents Int
  minimumPaymentCents   Int
  isEstimated           Boolean @default(false)

  payments CardPayment[]
  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, cycleEnd])
  @@index([accountId, dueDate])
}

model CardPayment {
  id          String @id @default(cuid())
  statementId String
  date        String // YYYY-MM-DD
  amountCents Int // positive = amount paid
  source      String // 'manual' | 'autopay' | 'detected-from-transactions'

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String  @id @default(cuid())
  accountId     String
  providerRef   String?
  date          String // YYYY-MM-DD
  amountCents   Int // outflow negative, inflow positive
  rawDescriptor String // "SQ *BLUE BOTTLE 0042 OAK"
  merchantId    String?
  categoryId    String?
  confidenceBps Int? // categorization confidence, 0–10000
  status        String  @default("POSTED") // PENDING | POSTED
  needsReview   Boolean @default(false)
  isTransfer    Boolean @default(false) // own-account transfers excluded from income/expense
  isSplitParent Boolean @default(false) // container row after a split — excluded from ALL sums
  splitParentId String?
  // Cycle-4 P1 (DECISIONS #148): set when a sync DISSOLVES a user's split — the forced
  // review must survive re-sends. A dissolved row is otherwise representationally an
  // UNDONE row, and the guard's "undone takes the fresh verdict" rule (cycle 1) let the
  // user's own merchant rule silently auto-file it one cron interval later. The preserve
  // predicate respects this flag; every USER filing action clears it.
  reviewPinned  Boolean @default(false)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  merchant Merchant? @relation(fields: [merchantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([accountId, providerRef]) // ingest idempotency: one row per provider txn id
  // (providerRef is null for manual/seed rows; multiple NULLs are allowed, so they're
  // unconstrained. Makes Plaid/SimpleFIN re-sync race-safe — Hostile Critic CQ-2.)
  @@index([accountId, date])
}

model Merchant {
  id                String  @id @default(cuid())
  canonical         String  @unique // "Blue Bottle Coffee"
  defaultCategoryId String?

  patterns     MerchantPattern[]
  transactions Transaction[]
  recurring    RecurringSeries[]
}

model MerchantPattern {
  id         String @id @default(cuid())
  merchantId String
  pattern    String
  kind       String // PREFIX | CONTAINS | REGEX

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Category {
  id            String  @id @default(cuid())
  name          String
  parentId      String?
  icon          String?
  isSystem      Boolean @default(false)
  // Custom (user-created) categories (DECISIONS #111): userId set, isSystem=false,
  // carrying a parent `group` name + discretionary flag. System rows keep
  // userId=null (global) and resolve via the static CATEGORY_BY_ID map, so these
  // DB columns are only read for CUSTOM rows. Name uniqueness is PER-USER so two
  // users can each own a "Golf" — the resolver is built per-request from a single
  // user's custom rows, so there is never cross-user name resolution.
  userId        String?
  group         String?
  discretionary Boolean @default(true)

  owner        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  rules        CategorizationRule[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([userId])
}

model CategorizationRule {
  id             String   @id @default(cuid())
  userId         String
  merchantId     String?
  minAmountCents Int? // contextual conditions — all optional, ANDed
  maxAmountCents Int?
  weekendOnly    Boolean?
  weekdayOnly    Boolean?
  accountId      String?
  categoryId     String
  priority       Int // user rules beat merchant defaults beat suggestion
  createdFrom    String? // correction id — provenance

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
}

model Correction {
  id             String   @id @default(cuid())
  userId         String
  transactionId  String
  fromCategoryId String?
  toCategoryId   String
  becameRuleId   String?
  // The id of the correction this row UNDOES (set only on inverse corrections from
  // undoCorrections). @@unique makes a double-undo of the same correction idempotent:
  // a second concurrent inverse insert hits the unique constraint and is skipped
  // (closes the alreadyUndone TOCTOU — STATUS #10). Multiple NULLs are allowed, so
  // ordinary corrections are unaffected.
  undoesId       String?  @unique
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Prediction log for the categorizer (DECISIONS #37): one row per transaction,
// recording what the pipeline predicted and with what confidence, plus the
// realized/confirmed category once known. Powers the accuracy + calibration
// (Brier) metric. actualCategoryId stays null until ground truth arrives
// (a known-merchant seed label, or a user confirmation/correction).
model CategoryPrediction {
  id                  String    @id @default(cuid())
  userId              String
  transactionId       String    @unique
  predictedCategoryId String
  confidenceBps       Int
  // Provenance of the predicted category (Why-This-Category §3.1): the pipeline's
  // CategorySource, or 'llm' when the assist overlay won an unsure row. Nullable:
  // NULL means the row predates this column (forward-only — the resolver reads
  // NULL as an honest 'not-recorded', never a guessed origin). A user-dictated
  // category (confidence 10000) is never logged here, so it has no source by
  // construction. See categorize/provenance.ts, WHY_THIS_CATEGORY_PLAN.md.
  source              String? // PredictionSource | null
  actualCategoryId    String? // null until confirmed/known
  // When a USER set actualCategoryId (filing/correcting in triage or the
  // register). Stays null for seed-time labels: per-user threshold tuning
  // (TASKS 3.6, DECISIONS #190) derives ONLY from user-labeled rows, so the
  // demo user's pre-labeled seed predictions can never activate tuning
  // (golden-safe) — the same "no corrections ⇒ derive nothing" property
  // learn.ts has. Cleared on undo, symmetric with actualCategoryId (#169).
  labeledAt           DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecurringSeries {
  id                  String  @id @default(cuid())
  userId              String
  merchantId          String
  cadence             String // WEEKLY | BIWEEKLY | MONTHLY | ANNUAL | IRREGULAR
  typicalAmountCents  Int
  lastAmountCents     Int
  previousAmountCents Int? // pre-price-change amount (old vs new, EDGE_CASES §Categorization)
  possiblyUnused      Boolean @default(false) // heuristic — surfaced as a question, never an accusation
  priceChangedAt      String? // YYYY-MM-DD
  lastSeenAt          String // YYYY-MM-DD — drives "unused 90+ days"
  nextExpectedAt      String? // YYYY-MM-DD
  isSubscription      Boolean

  merchant Merchant @relation(fields: [merchantId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ScheduledTransaction {
  id          String  @id @default(cuid())
  accountId   String
  description String
  amountCents Int // signed: outflow negative, inflow positive
  nextDate    String // YYYY-MM-DD
  cadence     String? // WEEKLY | BIWEEKLY | MONTHLY | null = one-off
  source      String // 'payroll-detected' | 'user' | 'autopay' | 'recurring' | 'seed'

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, nextDate])
}

// Month-end balance history per account — drives the net-worth trend chart.
// (Additive refinement over the Phase 0 draft; see docs/DECISIONS.md.)
model BalanceSnapshot {
  id           String @id @default(cuid())
  accountId    String
  date         String // YYYY-MM-DD (month end)
  balanceCents Int // stored positive, like Account.currentBalanceCents

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
}

model Goal {
  id                       String  @id @default(cuid())
  userId                   String
  name                     String
  targetCents              Int
  savedCents               Int     @default(0)
  targetDate               String? // YYYY-MM-DD
  monthlyContributionCents Int?
  // null = a savings goal (rendered via goalFIImpact); 'debt_free' = an inverse
  // debt-free-by-date plan (DECISIONS #125), rendered with the solver's own date
  // rather than the savings-goal timeline. Nullable + default-null ⇒ demo/golden untouched.
  kind                     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  monthCents Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  // One target per (user, category) — makes setBudget a single atomic upsert and
  // structurally precludes duplicate rows / the find-then-write race.
  @@unique([userId, categoryId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  meta      String // JSON-encoded (SQLite has no Json type)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The Trust Center ledger reads (userId, newest-first) on every /trust load,
  // and #242's per-LLM-call rows accelerate this table's growth — without an
  // index that read is a full scan (#242 critic cycle-2 F4).
  @@index([userId, createdAt])
}

// Durable, multi-instance rate-limit buckets (ROADMAP #8). The in-memory limiter
// in authz.ts is per-instance (a no-op across serverless invocations); this
// fixed-window counter lives in the DB so a limit holds across instances. `key`
// scopes the bucket (e.g. "signin:<email>", "export:<userId>"); `resetAt` is the
// window end. Rows are inert once expired and overwritten on the next hit.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  // Index-backed pruning of expired windows (the key space is attacker-controlled
  // via signin:<email>, so expired rows must be reclaimable without a table scan).
  @@index([resetAt])
}

// A browser Web-Push endpoint the user opted into (Gap 2 §2). Stores only the
// standard subscription triple (endpoint + the two RFC-8291 keys); the endpoint
// is @unique so re-subscribing the same browser upserts rather than duplicates.
// onDelete: Cascade so account deletion (DECISIONS #31) wipes these with the user.
// Fully dormant without VAPID_* env: nothing is ever stored unless a user with a
// configured deployment opts in.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // client public key (base64url) for payload encryption
  auth      String // client auth secret (base64url)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Idempotency log so a daily notification sweep never re-sends the same alert
// (Gap 2 §2 — the reminders cron had no dedup and would re-notify every run).
// `key` is the pure engine's stable notification key (e.g.
// "payment_due:<accountId>:<dueDate>"); @@unique([userId, key]) makes the first
// delivery win a race and every later sweep skip it. `sentAt` is index-backed so
// old rows prune without a table scan, mirroring RateLimit.
model NotificationSent {
  id     String   @id @default(cuid())
  userId String
  key    String
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([sentAt])
}

// Value-receipts ledger (TASKS 1.3, DECISIONS #206): one row per proactive catch
// Aimplifi actually surfaced — a payment reminder delivered, a radar dip warning
// delivered, or a price increase flagged. Rows are APPEND-ONLY facts copied verbatim
// from the source engines at the moment of the catch (never recomputed later, so the
// tally can't silently rewrite history when underlying data changes). `key` is the
// channel-agnostic idempotency key (an email and a push about the same due payment
// mint ONE receipt). `amountCents` meaning is per kind — see engine/receipts.
model ValueReceipt {
  id          String   @id @default(cuid())
  userId      String
  // 'reminder-delivered' | 'radar-catch' | 'price-increase' (engine/receipts kinds)
  kind        String
  key         String
  amountCents Int
  // Display label captured at catch time (account or merchant name) — data, not copy.
  label       String
  // Business calendar date of the catch (YYYY-MM-DD), per the date-discipline rule.
  occurredOn  String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No separate @@index([userId]): the unique's left prefix already covers it.
  @@unique([userId, key])
}

// Unknown-question ledger (TASKS 2.2, DECISIONS #208): every Ask the deterministic
// parser cannot route (including ones the optional LLM later rescues) appends one
// PII-scrubbed row for vocabulary mining (Wave 2.3). Append-only; no dedup — each
// ask is a mining signal. Never read by money engines → golden-safe.
model UnknownQuestion {
  id             String   @id @default(cuid())
  userId         String
  // Scrubbed question text only (emails/amounts/digits stripped) — never raw.
  scrubbedText   String
  // Raw kind from classifyIntentViaLLM before validation; null if LLM not called.
  llmGuessKind   String?
  // Final intent.kind after resolve (`unknown` or a rescued kind).
  resolvedIntent String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Learned vocabulary (TASKS 2.3, DECISIONS #225): a phrasing this ONE user asks
// repeatedly, which the deterministic parser cannot route, mined from that user's
// own UnknownQuestion rows by the weekly cron. PER-USER by construction — a phrase
// is user-authored text (scrubbed, not anonymized), so it never becomes another
// user's routing rule.
//
// An entry carries an intent KIND and nothing else. Every parameter (timeframe,
// category, merchant, amount, age) is re-derived from the asker's own words at
// answer time via intentFromKind + validateIntent — the same gate the LLM
// classifier's proposals pass. So a wrong entry can only route to a wrong KIND;
// it can never inject a figure, a window, or a category.
//
// status ladder (audit §4.2 loop 2): shadow (minted, NOT served — accruing
// held-out evidence) → flagged (served, with an "interpreted" disclosure the user
// can reject) → active (served, disclosed as learned, still undoable). `retired`
// is TERMINAL: a user rejection, or a single held-out disagreement, tombstones the
// phrase so the miner can never resurrect it on the same evidence.
model VocabEntry {
  id     String @id @default(cuid())
  userId String
  // Normalized, PII-scrubbed question key (scrub → lowercase → depunctuate). Digits
  // and amounts are already masked by the scrub, so one phrase spans "retire at 60"
  // and "retire at 67" — exactly the parameters intentFromKind re-derives.
  phrase String
  // One of LLM_ROUTABLE_KINDS. Never a parameter — see above.
  kind   String
  // 'shadow' | 'flagged' | 'active' | 'retired'
  status String @default("shadow")
  // Evidence, RECOMPUTED from the ledger on every mining run (never incremented —
  // the no-ratchet rule). Display + gate inputs only.
  supportCount  Int @default(0)
  heldOutHits   Int @default(0)
  heldOutMisses Int @default(0)
  servedCount   Int @default(0)
  // The newest ledger row that SUPPORTED the mint. Held-out evidence is everything
  // strictly newer. Drawn from the data, not from the miner's clock: a wall-clock
  // boundary lets a row stamped by a fast-clocked instance be recounted as held-out
  // evidence for a rule it helped create, defeating the only gate that validates a
  // promotion (#226).
  evidenceThrough DateTime?
  createdAt  DateTime  @default(now())
  promotedAt DateTime?
  retiredAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The unique's left prefix already covers a userId-only lookup.
  @@unique([userId, phrase])
}

// EngagementEvent ledger (TASKS 3.1, DECISIONS #209): first-party card
// interactions (viewed/dismissed/expanded/acted) for adaptive layout (3.3) and
// cadence (3.5). Closed-set surface/verb/subjectKey only — no free-text, no
// third-party analytics. Append-only; nothing reads these rows until 3.3.
model EngagementEvent {
  id         String   @id @default(cuid())
  userId     String
  surface    String // dashboard | coach | settings | ask | triage
  verb       String // viewed | dismissed | expanded | acted
  subjectKey String // closed-set card id (engine/engagement/event.ts)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, subjectKey])
}

// Nudge-feed suppression store (NUDGE_PLAN slice 2, DECISIONS #237). A DEDICATED
// dismissed-key store — deliberately SEPARATE from EngagementEvent. Its keys are the
// engine-minted `dismissKey`s, which embed a merchant and cents (e.g.
// `price-increase:Netflix:1999->2499`); EngagementEvent's closed-set, no-money
// subjectKey contract forbids storing those, so the two stores cannot be merged.
// Read into NudgeInput.dismissedKeys at feed-build time. NEVER routed into
// selectPaymentReminders' own upstream `dismissedKeys` filter — doing so would drop a
// reminder from the feed's INPUT before the engine's CRITICAL exemption can act while
// the push cron still pushed it (push-but-absent-from-feed, the bury failure). The
// shared demo user never writes here (session-only dismissal — see server/nudge.ts).
model NudgeDismissal {
  id         String   @id @default(cuid())
  userId     String
  dismissKey String // engine-minted Proposal.dismissKey (opaque to storage)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dismissKey])
  @@index([userId])
}

// Income-Pause Radar (#251, AI plan §Later #20): the user's explicit confirmation
// that a detected recurring income series has genuinely paused. This is the
// confirmation GATE for plan mutation: only a confirmed pause is excluded from the
// detected ScheduledTransaction projections (server/recurring.ts) — the radar alone
// never mutates a projection (a merely-late paycheck must not flip cash-needed into
// a false alarm). A confirmation is INERT the moment the series stops being lapsed
// (income resumed — lapse is recomputed from the series itself, never trusted from
// this row), and refreshRecurringForUser deletes the stale row then. The shared demo
// user never writes here (same fence as NudgeDismissal — see server/income-pause.ts).
model IncomePauseConfirmation {
  id                String   @id @default(cuid())
  userId            String
  merchantCanonical String // the paused series' canonical merchant (engine-minted)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantCanonical])
  @@index([userId])
}

// Weekly self-audit Critic (TASKS 3.2, DECISIONS #211): one row per user×ISO-week
// with review / unknown / alert-act rates (bps) + raw counts. No money fields;
// money engines never read this table. Upserted by /api/cron/audit.
model SelfAuditSnapshot {
  id              String   @id @default(cuid())
  userId          String
  weekStart       String // YYYY-MM-DD Monday
  reviewNeeding   Int      @default(0)
  reviewTotal     Int      @default(0)
  unknownStayed   Int      @default(0)
  unknownAttempts Int      @default(0)
  alertsSent      Int      @default(0)
  alertsActed     Int      @default(0)
  reviewRateBps   Int      @default(0)
  unknownRateBps  Int      @default(0)
  alertActRateBps Int      @default(0)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Household mode (TASKS 4.2 slice 1, HOUSEHOLD_ARCHITECTURE.md §4.2 — verbatim
// from the approved design doc). Additive only: the demo user joins no
// household, all three tables start empty, and every existing query keeps its
// userId scope, so demo/golden bytes are untouched by construction (T6).
// ---------------------------------------------------------------------------

model Household {
  id        String   @id @default(cuid())
  name      String // display name, e.g. "Our household"
  createdAt DateTime @default(now())

  members HouseholdMember[]
  invites HouseholdInvite[]
}

model HouseholdMember {
  id          String   @id @default(cuid())
  householdId String
  userId      String   @unique // v1: at most one household per user
  role        String // 'owner' | 'partner'
  joinedAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// Invite trust model (§4.3 rule 5): TWO factors — possession of a one-time code
// (hashed at rest, attempt-capped) + a DB-row email match for the signed-in
// accepter. No invite tokens in URLs. `expiresAt` is an operational timestamp
// (NotificationSent.sentAt precedent), lazily expired at read — no stored
// 'expired' status, no cron. `invitedById` is a plain string (no FK) so the
// row survives inviter deletion, like DeletionRecord.
model HouseholdInvite {
  id          String   @id @default(cuid())
  householdId String
  email       String // normalized (normalizeEmail), the invitee's sign-in email
  codeHash    String // hash of the one-time redemption code (never the code itself at rest)
  invitedById String // acting member's userId (plain string, no FK)
  status      String   @default("pending") // 'pending' | 'accepted' | 'declined' | 'revoked'
  attempts    Int      @default(0) // failed redemption attempts (hard cap -> revoked)
  createdAt   DateTime @default(now())
  expiresAt   DateTime // operational timestamp — lazy-expired at read

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, email])
  @@index([email])
}
